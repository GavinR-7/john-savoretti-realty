# Copy this file to .env.local for local secrets. .env.local is gitignored —
# real keys never go in chat, in git, or in this example file.

# For wiring the lead form to real email later (see README "Wiring the forms"):
# RESEND_API_KEY=
# LEADS_TO_EMAIL=OfficeAdmin@JohnSavorettiRealty.com

NEXT_PUBLIC_SITE_URL=https://john-savoretti-realty.vercel.app/

DATABASE_URL=
MLSGRID_TOKEN=

# Vercel Blob store — where sync'd MLS photos are re-hosted.
BLOB_READ_WRITE_TOKEN=
MLSGRID_API_URL=

# ── Lead email (app/api/lead) ──────────────────────────────────────────────
# Get a key at resend.com. A send failure returns 500 so the form shows its
# error rather than a fake success, so these must be set in production.
RESEND_API_KEY=
# Where leads land. Confirm with John before launch.
LEAD_TO_EMAIL=
# Sender. Leave blank to use Resend's shared onboarding@resend.dev, which
# needs no verified domain but can ONLY deliver to the Resend account owner's
# own address. Once johnsavorettirealty.com is verified in Resend, set this to
# e.g. "Website Leads <leads@johnsavorettirealty.com>".
LEAD_FROM_EMAIL=

# ── Scheduled sync (app/api/cron/sync, every 15 min per vercel.json) ───────
# Any long random string. Vercel Cron sends it as a bearer token; the route
# refuses to run without it.
CRON_SECRET=

# Absolute site URL used by the sitemap.
# NEXT_PUBLIC_SITE_URL=https://johnsavorettirealty.com
# Contact form spam protection; configure an Invisible widget per project.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
